# macOS
.DS_Store
._*

# Backups
*.bak
*.bak-*
.backups/

# Cache local
.vibeflow-cache/

# Artefacts d'install locale (le repo est la SOURCE des modules, PAS un lab :
# lancer l'engine en scope project/local y déposerait des copies du distribuable).
.claude/
docs/reference/

# Registre + temporaires de l'engine
.vibeflow-installed
*.tmp

# Pointeur de workstream actif : état LOCAL à une session, jamais partagé.
# C'est le repli du moteur GSD quand aucune identité de session ne résout. S'il était
# committé, deux personnes travaillant sur des workstreams différents s'écraseraient
# mutuellement la sélection au prochain pull — soit exactement le conflit que la
# partition en workstreams vise à supprimer. Vérifié en bac à sable le 2026-07-30.
.planning/active-workstream

# Dépendances / environnements (au cas où un module ajoute de l'outillage)
node_modules/
.venv/
venv/

# Logs
*.log
logs/

# Editor
.vscode/
.idea/
*.swp

# Python cache
__pycache__/
*.pyc

# Verrou de driver d'une mission d'équipe (conductor/scripts/driver-lock.sh) :
# état runtime local, jamais versionné — un lock committé bloquerait toute
# mission ultérieure sur les autres clones.
.planning/DRIVER.lock/
