#!/usr/bin/env bash
# pre-push — Discipline de release : si on pousse `main`, la VERSION racine doit être taggée.
#
# Ne bloque QUE les push vers main (les branches de feature poussent librement — le tag vient
# après le merge). Opt-in, non installé par défaut. Activation une seule fois :
#   git config core.hooksPath scripts/hooks
#
# RÉSOLUTION DE L'EXÉCUTABLE (arbitrage Samuel, AskUserQuestion session principale, 2026-09-10) :
# `check-release-tag.sh` est résolu depuis le dépôt PRINCIPAL (`git rev-parse --git-common-dir`,
# stable à travers `git worktree add`), JAMAIS depuis `--show-toplevel` du répertoire de travail
# courant. Même motif RCE que `post-merge` (voir son en-tête pour le détail complet) : un
# `git worktree add` sur une branche hostile fait pointer `--show-toplevel` sur un arbre
# entièrement contrôlé par l'attaquant, et y résoudre le script exécuté serait un candidat RCE
# (mesuré par exécution réelle : une copie malveillante de `check-release-tag.sh` posée dans un
# tel worktree s'exécute au premier `git push`). `--git-common-dir` reste ancré sur le `.git` du
# dépôt d'origine quel que soit le worktree courant. Dériver depuis l'emplacement du hook
# (`dirname "$0"`) ne suffit pas non plus : sous `core.hooksPath` RELATIF (la convention
# documentée ci-dessus), git résout aussi le hook lui-même depuis le worktree courant, donc `$0`
# pointerait tout autant vers l'arbre hostile. Seul `--git-common-dir` échappe à ce biais.
set -uo pipefail
main_root="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
blocked=0
while read -r _localref _localsha remoteref _remotesha; do
  case "$remoteref" in
    refs/heads/main)
      bash "$main_root/scripts/check-release-tag.sh" || blocked=1
      ;;
  esac
done
[ "$blocked" -eq 0 ] || {
  echo "[pre-push] push vers main bloqué : release non taggée (voir ci-dessus)." >&2
  exit 1
}
exit 0
