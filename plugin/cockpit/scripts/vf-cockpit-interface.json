{
  "version": 1,
  "description": "Contrat versionné des sorties JSON du socle du cockpit VibeFlow (P67-D-12), lu par vf-signal par l'émetteur signal@1 (P68-D-15), et des clés internes de Claude Code dont il dépend.",
  "avancement": {
    "version": 2,
    "description": "objet posé par readPlanning sur chaque phase ; lu par vf-signal par l'émetteur signal@1 ; version 2 : état de mission abandonnee et inconnu, champ mission.vie (P68-D-16, P68-D-23) ; cascade de vie (P68-D-26, P68-D-27, P68-D-33) : verrou de la phase (même périmé), sinon verrou du compartiment, sinon verrou de dépôt (dont l'ancien .planning/DRIVER.lock) ; un verrou présent, même périmé, arrête la cascade (P68-D-27, P68-D-36) ; périmé ou aucun verrou : abandonnee ; source illisible : inconnu ; un âge de progression négatif est traité comme absent",
    "requis": { "version": "number", "etat": "string", "plans": "object", "correctifs": "number", "mission": "any", "reste": "array" },
    "etats": ["a-faire", "en-cours", "a-recetter", "fait"],
    "reste": ["cadrage", "plan", "execution", "recette", "verification", "cloture"],
    "missionEtats": ["running", "abandonnee", "inconnu", "failed", "done", "ready"],
    "vie": { "requis": { "tenu": "boolean", "stale": "any", "progressAgeS": "any", "ttl": "any" } }
  },
  "schemas": {
    "vibeflow/cockpit-signal@1": {
      "requis": { "schema": "string", "at": "string", "root": "string", "projet": "string", "layout": "object", "phases": "array", "jalons": "array", "missions": "array", "verrous": "object", "arbres": "array", "equipe": "object" },
      "phase": { "requis": ["key", "n", "ws", "nom", "fait", "avancement", "libelle"], "optionnels": [] },
      "jalon": { "requis": ["key", "icone", "texte", "ws", "phases"], "optionnels": [] },
      "mission": { "requis": ["nom", "fichier", "phaseKey", "ws", "etat", "libelle", "vie"], "optionnels": ["noeuds"], "vieNulle": ["inconnu", "done", "ready", "failed"], "vieNulleDit": "vie vaut null seulement pour ces etats : inconnu = source des verrous illisible ; done, ready, failed = aucun noeud running, verrous non lus. running et abandonnee portent toujours une vie. Lire vie: null sur etat, jamais seul." },
      "noeud": { "requis": ["id", "status", "step", "stage", "deps"], "optionnels": [] },
      "verrou": { "requis": ["ws", "scope", "phase", "tenu", "stale", "ageS", "ttl", "progressAgeS", "owner"], "dag": { "cles": ["ws", "phase", "at", "nodes"], "noeud": ["id", "deps", "status"], "statuts": ["blocked", "ready", "running", "done", "failed"], "bornes": { "noeuds": 200, "dependances": 32, "identifiant": 64 } }, "optionnels": ["step", "childrenRunning", "dag", "leaseS", "sansSession"] },
      "arbre": { "requis": ["label", "branche", "principal", "courant", "phaseActive", "retard"], "optionnels": [] },
      "retard": { "requis": ["base", "main", "origin", "fetchAgeS"], "optionnels": [] },
      "etatsVerrous": ["lue", "absente", "erreur"],
      "interdits": ["doing", "mandat", "messages", "outils", "fil"]
    },
    "vibeflow/cockpit-state@1": {
      "description": "GET /api/vf/state (79-12, C2) : l'enveloppe de l'état du cockpit. `signal` est le `signal` de vibeflow/cockpit-signal@1, de forme inchangée, nul seulement avant la première collecte (collecte.etat vaut alors en-cours). `collecte` : liste blanche de cinq champs ; les diagnostics du direct restent sur /api/vf/etat.",
      "requis": { "schema": "string", "at": "string", "seq": "number", "collecte": "object", "signal": "any" },
      "collecte": { "requis": ["etat", "derniereA", "dureeMs", "mode", "clients"], "optionnels": [], "etats": ["ok", "en-cours", "partielle", "indisponible"], "modes": ["watch", "poll", "absent"] },
      "interdits": ["doing", "mandat", "messages", "outils", "fil"]
    },
    "vibeflow/cockpit-who@2": {
      "requis": { "at": "string", "root": "string", "trees": "array", "fresh": "number", "fenetre": "number", "busy": "boolean", "workers": "array", "sources": "object" },
      "optionnels": ["sortisSilence"],
      "travailleur": {
        "requis": ["kind", "id", "tree", "source"],
        "optionnels": ["role", "task", "titre", "parent", "depth", "background", "branch", "treeBy", "cwd", "ageS", "lastAt", "stale", "orphan", "children", "dag", "etat", "dureeS", "finAt", "finMotif", "action", "rattachement", "enCours"],
        "motifsFin": ["echec", "arret"],
        "etats": ["actif", "en-attente", "au-repos", "attend", "termine"]
      },
      "rattachement": {
        "etats": ["rattache", "non-rattache"],
        "raisons": ["sans-citation", "inconnu", "ambigu"]
      },
      "interdits": ["doing", "mandat", "messages", "outils", "fil"],
      "kinds": ["session", "subagent", "lock", "registered", "dag-node"],
      "etatsSource": ["lue", "absente", "erreur", "forme-inconnue"]
    },
    "vibeflow/cockpit-project@1": {
      "description": "Champs facultatifs de traçabilité (76-04, P76-D-31, A32 de la 79) : `trace` d'un nœud de phase (plans, correctifs, verification, recette, preuves), `meta.vf.trace` (exigences dont `cites`, étapes, registresSansPhase, ou { erreur: true } si la lecture a échoué), `meta.vf.registres` (définitions des registres par phase), `meta.vf.jalonActif`. Tout texte y est nettoyé, masqué et sans chemin du poste. La version du schéma ne monte pas.",
      "requis": { "schema": "string", "meta": "object", "project": "object", "nodes": "array", "files": "array", "links": "array", "flows": "array" },
      "noeud": { "requis": ["id", "label", "kind"] },
      "element": { "requis": ["p", "n", "name"] },
      "lien": { "requis": ["a", "b", "k"] },
      "statuts": ["done", "active", "recette", "todo", "blocked"],
      "optionnels": { "noeud": ["avancement", "exigences", "trace"], "element": ["vague"], "metaVf": ["trace", "registres", "jalonActif"] },
      "meta": { "requis": ["vfTab", "vf", "kindLabels"] }
    },
    "vibeflow/cockpit-transcript@2": {
      "requis": { "schema": "string", "id": "string" },
      "optionnels": ["mandat", "fil", "tronque", "erreur"]
    },
    "vibeflow/cockpit-index@1": {
      "description": "fichier d'index incrémental des transcripts du lab (.vibeflow/cockpit/.cache/index-transcripts.json), écrit par le seul serveur, jamais servi tel quel, ni exporté, ni évalué ; non fiable à la lecture (schéma, version et bornes revérifiés, fichier invalide écarté puis reconstruit) ; borné à heures, durées, jetons et verbes, sans texte ni cible",
      "requis": { "schema": "string", "ccVerifie": "string", "versionsVues": "array", "genereA": "string", "fenetreS": "number", "evinces": "number", "voies": "array" },
      "voie": ["id", "kind", "session", "parent", "depth", "role", "arbre", "background", "debut", "fin", "dispatchA", "fini", "arrete", "modeles", "compteurs", "jetons", "durees", "segments", "evenements", "enCours", "forme", "tronque", "versions", "curseur"],
      "curseur": ["octets", "taille", "mtimeMs", "tete", "dernierMsgId", "usage", "maxClos", "clos", "ouverts", "lancements", "etat", "saut"],
      "segments": ["travail", "attend-agents", "attend-humain", "repos", "silence"],
      "evenements": ["compaction", "erreur", "humain", "rapport", "dispatch"],
      "compteurs": ["appels", "erreurs", "refus", "questions", "compactions", "tours", "reponsesApi"],
      "jetons": ["entree", "sortie", "cacheLu", "cacheCree", "contexteMax", "contexteDernier"],
      "durees": ["travailS", "attenteHumainS", "attenteAgentsS", "reposS", "silenceS"],
      "bornes": { "fenetreS": 86400, "silenceS": 180, "segments": 500, "evenements": 500, "ouverts": 64, "lancements": 256, "clos": 256, "modeles": 4, "versions": 4, "versionsVues": 8, "role": 64, "arbre": 200, "tete": 1024, "bloc": 1048576, "ligneMax": 33554432, "fichierOctets": 33554432, "voiesMax": 2000 },
      "interdits": ["doing", "mandat", "messages", "outils", "fil"],
      "jamaisStocke": ["cibles", "ecritures", "lectures", "cible"]
    },
    "vibeflow/cockpit-equipe@1": {
      "requis": { "schema": "string", "meta": "object", "project": "object", "nodes": "array", "files": "array", "links": "array", "flows": "array" },
      "noeud": { "requis": ["id", "label", "kind"] },
      "lien": { "requis": ["a", "b", "k"] },
      "statuts": ["done", "active"],
      "interdits": ["doing", "mandat", "messages", "outils", "fil"],
      "meta": { "requis": ["vfTab", "vf", "kindLabels"] }
    },
    "vibeflow/cockpit-doing@1": {
      "requis": { "schema": "string", "id": "string", "doing": "any" }
    },
    "vibeflow/cockpit-frise@1": {
      "description": "frise des voies des dernières 24 h, lue en mémoire (79-13, GET /api/vf/frise) ; cibles jamais persistées",
      "requis": { "schema": "string", "at": "string", "depuis": "number", "jusqua": "number", "fenetreS": "number", "source": "object",
        "voiesOmises": "number", "tronque": "boolean", "voies": "array" },
      "voie": ["id", "kind", "session", "parent", "depth", "role", "arbre", "background", "debut", "fin", "dispatchA", "fini", "arrete", "etatOfficiel",
        "modeles", "compteurs", "jetons", "durees", "segments", "evenements", "enCours", "rattachement", "cibles"],
      "source": { "requis": ["etat", "ccVerifie", "versionsVues"], "etats": ["ok", "en-construction", "partielle", "forme-inconnue", "indisponible"] },
      "segments": ["travail", "attend-agents", "attend-humain", "repos", "silence"],
      "evenements": ["compaction", "erreur", "humain", "rapport", "dispatch"],
      "champs": ["cibles"],
      "outils": { "lectures": ["Read"], "ecritures": ["Write", "Edit", "MultiEdit", "NotebookEdit"] },
      "bornes": { "fenetreS": 86400, "segments": 500, "evenements": 500, "cibles": 200, "ciblesTotal": 20000, "voiesInstantane": 2000,
        "voiesReponse": 500, "cibleUnites": 120 },
      "cible": ["arbre", "cible", "n", "dernierMs"],
      "cibles": { "requis": ["etat", "tronque", "ecritures", "lectures"], "etats": ["ok", "en-construction"] },
      "interdits": ["doing", "mandat", "messages", "outils", "fil"]
    },
    "vibeflow/cockpit-activite@1": {
      "description": "activité sur le code, lue en mémoire (75-05, GET /api/vf/activite) : points chauds, couplage, gardes, empreinte des agents, radar de collisions ; tableaux de tuples, jamais un chemin, une branche, un rôle ou un titre comme clé d'objet ; jamais dans l'export autonome (A25)",
      "requis": { "schema": "string", "at": "string", "etat": "string", "calcul": "string", "git": "object", "branches": "object", "gardes": "object", "empreinte": "object", "collisions": "array", "radar": "object" },
      "etats": ["ok", "en-calcul", "indisponible"],
      "calcul": ["pret", "en-cours"],
      "git": { "etats": ["ok", "vide", "indisponible", "absent", "en-lecture"], "tuples": { "chauds": ["chemin", "commits", "loc", "rang", "palier"], "couplage": ["a", "b", "communes", "degre"] } },
      "branches": { "etats": ["ok", "indisponible", "absent", "en-lecture"] },
      "gardes": { "etats": ["ok", "non-lues", "indisponible", "en-lecture"], "tuples": { "gardes": ["chemin", "suites", "estGarde"] } },
      "empreinte": { "etats": ["ok", "en-construction", "tronque", "indisponible"], "degres": ["en-cours", "modifie", "lu", "fini"], "tuples": { "marques": ["chemin", "degre", "noms"] } },
      "collisions": { "sources": ["agents", "arbres", "branches", "plans"], "tuple": ["chemin", "source", "noms", "vague"], "plafond": 500 },
      "radar": { "raisons": ["en-construction", "tronque", "cibles-coupees", "agents-indisponible", "plans-indisponible", "branches-indisponible", "plans-tronques", "collisions-tronquees"] },
      "cles": ["schema", "at", "etat", "calcul", "git", "branches", "gardes", "empreinte", "collisions", "radar", "fenetre", "jours", "commits", "plafond", "plafondAtteint", "partiel",
        "chauds", "couplage", "paliers", "tetes", "estGarde", "prevusIgnores", "incomplet", "limite", "marques", "horsCarte", "horsLab", "coupees", "rejetes", "ignorees",
        "voiesTronquees", "voiesCiblesTronquees", "raisons", "total", "tronque", "sansVague", "plansTronques", "limites"],
      "interdits": ["doing", "mandat", "messages", "outils", "fil"]
    },
    "vibeflow/cockpit-git@1": {
      "description": "topologie Git du lab pour le tiroir (78-05, GET /api/vf/git) : requis vaut pour etat ok ; les autres etats ne portent que schema, etat, entete (sauf absent : schema, etat, entete) et commandes. auteurs : agrégés sur la fenêtre de commits lue (500 de la base et des branches non mergées), pas sur tout l'historique : l'écran ne doit pas dire « tous les auteurs ». refsIgnorees : nombre de refs sans date (tag vers un blob ou un arbre) écartées, le reste du graphe est lu",
      "requis": { "schema": "string", "etat": "string", "entete": "object", "base": "object", "worktrees": "array", "rangees": "array", "couloirsMax": "number", "replies": "number", "refsIgnorees": "number", "horsFenetre": "array", "mergees": "array", "tags": "array", "stash": "array", "auteurs": "array", "parBranche": "array", "bornes": "object", "commandes": "object" },
      "etats": ["ok", "vide", "indisponible", "absent"],
      "rangee": { "requis": ["h", "h7", "p", "at", "an", "s", "col", "entrants", "sortants", "largeur", "ouvertBas", "fusion", "racine", "teinte", "refs", "refsPlus"] },
      "interdits": ["doing", "mandat", "messages", "outils", "fil"]
    },
    "vibeflow/cockpit-git-commit@1": {
      "description": "détail d'un commit sans diff (78-08, GET /api/vf/git/commit?sha=) : requis vaut pour etat ok ; sha-invalide (400) et commit-inconnu (404) ne portent que schema et etat ; indisponible (200) aussi",
      "requis": { "schema": "string", "etat": "string", "h": "string", "h7": "string", "p": "array", "auteur": "string", "date": "string", "committer": "string", "dateCommit": "string", "message": "string", "tronque": "boolean", "fichiers": "array", "total": "number", "commandes": "object" },
      "fichier": { "requis": ["chemin", "ancien", "plus", "moins", "binaire"] },
      "etats": ["ok", "sha-invalide", "commit-inconnu", "indisponible"],
      "interdits": ["email", "diff", "patch"]
    },
    "vibeflow/cockpit-git-worktrees@1": {
      "description": "état de chaque worktree, à la demande (78-08, GET /api/vf/git/worktrees ; jamais dans le filet de 5 s) : modifies et nonSuivis bornés à 200 entrées lues (plus vrai au-delà) ; avance et retard sur la base locale, avanceOrigin et retardOrigin sur origin/<base> seulement quand elle diverge de la locale (sinon null) ; approximatif vrai (mention « approximatif : filtres du dépôt non exécutés » ; mention vaut null quand approximatif est faux) quand le dépôt déclare un filtre ; nom d'un worktree jamais une clé unique : le chemin l'est ; verifie (boolean, P78-D-38) : faux quand `<chemin>/.git` ne désigne pas `<commun>/worktrees/<id>` du dépôt lu (lien `gitdir` forgé) : le worktree est alors « non vérifié », jamais lu (status non lancé), modifies, nonSuivis, propre, avance, retard, avanceOrigin, retardOrigin et commande valent null et plus faux — la page doit afficher « non vérifié » quand verifie === false (même champ verifie sur chaque entrée worktrees de vibeflow/cockpit-git@1, dont la commande cd est alors null)",
      "requis": { "schema": "string", "etat": "string", "approximatif": "boolean", "mention": "string|null", "tronque": "boolean", "worktrees": "array" },
      "worktree": { "requis": ["chemin", "nom", "verifie", "modifies", "nonSuivis", "plus", "propre", "avance", "retard", "avanceOrigin", "retardOrigin", "commande"],
        "types": { "chemin": "string", "nom": "string", "verifie": "boolean", "modifies": "number|null", "nonSuivis": "number|null", "plus": "boolean", "propre": "boolean|null", "avance": "number|null", "retard": "number|null", "avanceOrigin": "number|null", "retardOrigin": "number|null", "commande": "string|null" } },
      "etats": ["ok", "indisponible"],
      "interdits": ["email", "diff", "patch"]
    },
    "vibeflow/cockpit-git-entete@1": {
      "requis": { "schema": "string", "etat": "string", "depot": "string" },
      "optionnels": ["branche", "worktree", "detache", "sha7"],
      "etats": ["ok", "indisponible", "absent"]
    }
  },
  "claudeCode": {
    "verifieSur": "2.1.322",
    "transcript": {
      "requis": ["cwd", "type", "message", "timestamp", "sessionId"],
      "attendus": ["gitBranch", "version"]
    },
    "metaSousAgent": {
      "requis": ["agentType", "description", "spawnDepth", "toolUseId", "requestShape"],
      "requisSiProfondeur": { "parentAgentId": 2 },
      "booleensFacultatifs": ["finished"],
      "formeArretee": { "requis": ["agentType", "stoppedByUser"], "booleens": ["stoppedByUser"] }
    },
    "transcriptSousAgent": {
      "requis": ["isSidechain", "agentId"]
    },
    "index": {
      "description": "champs du transcript lus par l'index incrémental (vibeflow/cockpit-index@1) : chemins pointés lus par l'accesseur unique de vf-cockpit-index-voie.mjs, jamais un texte, une entrée ou une sortie d'outil. requis : un champ absent ou de mauvais type rend la voie de forme inconnue, mesures nulles ; facultatifs : absents sans conséquence",
      "lignesDatees": { "types": ["user", "assistant"], "requis": ["timestamp"], "facultatifs": ["type", "version", "cwd", "message.content"] },
      "assistant": { "requis": ["message.id", "message.usage.input_tokens", "message.usage.output_tokens"], "facultatifs": ["message.usage.cache_read_input_tokens", "message.usage.cache_creation_input_tokens", "message.model", "message.stop_reason", "message.content"] },
      "appel": { "requis": ["id", "name"] },
      "resultat": { "requis": ["tool_use_id"], "facultatifs": ["is_error"] },
      "systeme": { "facultatifs": ["subtype", "pendingBackgroundAgentCount", "timestamp"] },
      "origine": { "facultatifs": ["origin.kind"] },
      "permission": { "facultatifs": ["permissionDecision.decision"] },
      "types": { "type": "string", "timestamp": "string", "version": "string", "cwd": "string", "message.id": "string", "message.usage.input_tokens": "number", "message.usage.output_tokens": "number", "message.usage.cache_read_input_tokens": "number", "message.usage.cache_creation_input_tokens": "number", "message.model": "string", "message.stop_reason": "string", "message.content": "array", "id": "string", "name": "string", "tool_use_id": "string", "is_error": "boolean", "subtype": "string", "pendingBackgroundAgentCount": "number", "origin.kind": "string", "permissionDecision.decision": "string" }
    },
    "vueAgents": {
      "description": "sortie de `claude agents --json` (AUDC-V8) : source de référence de l'état des sessions, lue derrière ce contrat de forme (AUDC-Q4) ; les transcripts en sont le repli quand la commande est absente, en échec, trop lente ou de forme inattendue",
      "cleSession": "sessionId",
      "etats": { "working": "actif", "blocked": "attend", "done": "termine", "failed": "termine", "stopped": "termine" },
      "motifs": { "failed": "echec", "stopped": "arret" },
      "motifsDit": "cause d'une session finie, jamais d'un état vivant : `failed` donne `echec`, `stopped` donne `arret`, `done` aucune ; elle sort en `finMotif` du travailleur (l'état reste `termine`)",
      "statuts": { "busy": "actif", "waiting": "attend", "idle": "au-repos" }
    },
    "cibles": {
      "description": "champs du transcript lus par le lecteur de cibles de la frise (79-13) : chemins pointés, jamais un texte ni une sortie d'outil",
      "chemins": ["type", "timestamp", "message.content", "name", "input.file_path", "input.notebook_path"],
      "jamaisPersiste": true
    },
    "transcriptTitre": {
      "type": "custom-title",
      "champ": "customTitle",
      "typeChamp": "string",
      "refuse": ["ai-title"]
    }
  }
}
