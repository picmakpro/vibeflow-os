{
  "description": "Gouvernance mémoire machine-enforced (ADR-032 + ADR-043) : instanciation des registres du lab courant à l'ouverture de session (indispensable en scope user, où l'install ne peut pas connaître les projets à l'avance), lecture index-first bloquante, index auto-maintenu, lint format au démarrage, archivage en fin de session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/guard-read-registres.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/guard-bash-registres.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/post-edit-reindex.sh || true" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/seed-registres.sh --project --quiet || true" },
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/check-registres.sh --hook || true" },
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/probe-memory-guards.sh || true" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash {{VF_SCRIPTS}}/archive.sh --async --apply || true" }
        ]
      }
    ]
  }
}
