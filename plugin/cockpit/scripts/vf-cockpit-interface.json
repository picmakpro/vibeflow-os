{
  "version": 1,
  "description": "Contrat versionné des sorties JSON du socle du cockpit VibeFlow (P67-D-12), lu par vf-signal par l'émetteur signal@1 (P68-D-15), et des clés internes de Claude Code dont il dépend.",
  "avancement": {
    "version": 2,
    "description": "objet posé par readPlanning sur chaque phase ; lu par vf-signal par l'émetteur signal@1 ; version 2 : état de mission abandonnee et inconnu, champ mission.vie (P68-D-16, P68-D-23)",
    "requis": { "version": "number", "etat": "string", "plans": "object", "correctifs": "number", "mission": "any", "reste": "array" },
    "etats": ["a-faire", "en-cours", "a-recetter", "fait"],
    "reste": ["recette", "verification", "cloture"],
    "missionEtats": ["running", "abandonnee", "inconnu", "failed", "done", "ready"],
    "vie": { "requis": { "tenu": "boolean", "stale": "any", "progressAgeS": "any", "ttl": "any" } }
  },
  "schemas": {
    "vibeflow/cockpit-signal@1": {
      "requis": { "schema": "string", "at": "string", "root": "string", "projet": "string", "layout": "object", "phases": "array", "jalons": "array", "missions": "array", "verrous": "object", "arbres": "array", "equipe": "object" },
      "phase": { "requis": ["key", "n", "ws", "nom", "fait", "avancement", "libelle"], "optionnels": [] },
      "jalon": { "requis": ["key", "icone", "texte", "ws", "phases"], "optionnels": [] },
      "mission": { "requis": ["nom", "fichier", "phaseKey", "ws", "etat", "libelle", "vie"], "optionnels": ["noeuds"] },
      "noeud": { "requis": ["id", "status", "step", "stage", "deps"], "optionnels": [] },
      "verrou": { "requis": ["ws", "scope", "phase", "tenu", "stale", "ageS", "ttl", "progressAgeS", "owner"], "optionnels": [] },
      "arbre": { "requis": ["label", "branche", "principal", "courant", "phaseActive", "retard"], "optionnels": [] },
      "retard": { "requis": ["base", "main", "origin", "fetchAgeS"], "optionnels": [] },
      "etatsVerrous": ["lue", "absente", "erreur"],
      "interdits": ["doing", "mandat", "messages", "outils"]
    },
    "vibeflow/cockpit-who@2": {
      "requis": { "at": "string", "root": "string", "trees": "array", "fresh": "number", "fenetre": "number", "busy": "boolean", "workers": "array", "sources": "object" },
      "travailleur": {
        "requis": ["kind", "id", "tree", "source"],
        "optionnels": ["role", "task", "parent", "depth", "background", "branch", "treeBy", "cwd", "ageS", "lastAt", "stale", "orphan", "children", "dag", "etat", "dureeS", "finAt", "action", "rattachement"],
        "etats": ["actif", "en-attente", "termine"]
      },
      "rattachement": {
        "etats": ["rattache", "non-rattache"],
        "raisons": ["sans-citation", "inconnu", "ambigu"]
      },
      "interdits": ["doing", "mandat", "messages", "outils"],
      "kinds": ["session", "subagent", "lock", "registered", "dag-node"],
      "etatsSource": ["lue", "absente", "erreur", "forme-inconnue"]
    },
    "vibeflow/cockpit-project@1": {
      "requis": { "schema": "string", "meta": "object", "project": "object", "nodes": "array", "files": "array", "links": "array", "flows": "array" },
      "noeud": { "requis": ["id", "label", "kind"] },
      "element": { "requis": ["p", "n", "name"] },
      "lien": { "requis": ["a", "b", "k"] },
      "statuts": ["done", "active", "todo", "blocked"],
      "meta": { "requis": ["vfTab", "vf", "kindLabels"] }
    },
    "vibeflow/cockpit-transcript@1": {
      "requis": { "schema": "string", "id": "string" },
      "optionnels": ["mandat", "messages", "outils", "tronque", "erreur"]
    },
    "vibeflow/cockpit-equipe@1": {
      "requis": { "schema": "string", "meta": "object", "project": "object", "nodes": "array", "files": "array", "links": "array", "flows": "array" },
      "noeud": { "requis": ["id", "label", "kind"] },
      "lien": { "requis": ["a", "b", "k"] },
      "statuts": ["done", "active"],
      "interdits": ["doing", "mandat", "messages", "outils"],
      "meta": { "requis": ["vfTab", "vf", "kindLabels"] }
    },
    "vibeflow/cockpit-doing@1": {
      "requis": { "schema": "string", "id": "string", "doing": "any" }
    }
  },
  "claudeCode": {
    "verifieSur": "2.1.317",
    "transcript": {
      "requis": ["cwd", "type", "message", "timestamp", "sessionId"],
      "attendus": ["gitBranch", "version"]
    },
    "metaSousAgent": {
      "requis": ["agentType", "description", "spawnDepth", "toolUseId", "requestShape"],
      "requisSiProfondeur": { "parentAgentId": 2 },
      "booleensFacultatifs": ["finished"],
      "formeArretee": { "requis": ["agentType", "stoppedByUser"], "booleens": ["stoppedByUser"] }
    },
    "transcriptSousAgent": {
      "requis": ["isSidechain", "agentId"]
    }
  }
}
