{
  "version": 1,
  "description": "Contrat versionné des sorties JSON du socle du cockpit VibeFlow (P67-D-12), lu par vf-signal par l'émetteur signal@1 (P68-D-15), et des clés internes de Claude Code dont il dépend.",
  "avancement": {
    "version": 2,
    "description": "objet posé par readPlanning sur chaque phase ; lu par vf-signal par l'émetteur signal@1 ; version 2 : état de mission abandonnee et inconnu, champ mission.vie (P68-D-16, P68-D-23) ; cascade de vie (P68-D-26, P68-D-27, P68-D-33) : verrou de la phase (même périmé), sinon verrou du compartiment, sinon verrou de dépôt (dont l'ancien .planning/DRIVER.lock) ; un verrou présent, même périmé, arrête la cascade (P68-D-27, P68-D-36) ; périmé ou aucun verrou : abandonnee ; source illisible : inconnu ; un âge de progression négatif est traité comme absent",
    "requis": { "version": "number", "etat": "string", "plans": "object", "correctifs": "number", "mission": "any", "reste": "array" },
    "etats": ["a-faire", "en-cours", "a-recetter", "fait"],
    "reste": ["cadrage", "plan", "execution", "recette", "verification", "cloture"],
    "missionEtats": ["running", "abandonnee", "inconnu", "failed", "done", "ready"],
    "vie": { "requis": { "tenu": "boolean", "stale": "any", "progressAgeS": "any", "ttl": "any" } }
  },
  "schemas": {
    "vibeflow/cockpit-signal@1": {
      "requis": { "schema": "string", "at": "string", "root": "string", "projet": "string", "layout": "object", "phases": "array", "jalons": "array", "missions": "array", "verrous": "object", "arbres": "array", "equipe": "object" },
      "phase": { "requis": ["key", "n", "ws", "nom", "fait", "avancement", "libelle"], "optionnels": [] },
      "jalon": { "requis": ["key", "icone", "texte", "ws", "phases"], "optionnels": [] },
      "mission": { "requis": ["nom", "fichier", "phaseKey", "ws", "etat", "libelle", "vie"], "optionnels": ["noeuds"], "vieNulle": ["inconnu", "done", "ready", "failed"], "vieNulleDit": "vie vaut null seulement pour ces etats : inconnu = source des verrous illisible ; done, ready, failed = aucun noeud running, verrous non lus. running et abandonnee portent toujours une vie. Lire vie: null sur etat, jamais seul." },
      "noeud": { "requis": ["id", "status", "step", "stage", "deps"], "optionnels": [] },
      "verrou": { "requis": ["ws", "scope", "phase", "tenu", "stale", "ageS", "ttl", "progressAgeS", "owner"], "optionnels": [] },
      "arbre": { "requis": ["label", "branche", "principal", "courant", "phaseActive", "retard"], "optionnels": [] },
      "retard": { "requis": ["base", "main", "origin", "fetchAgeS"], "optionnels": [] },
      "etatsVerrous": ["lue", "absente", "erreur"],
      "interdits": ["doing", "mandat", "messages", "outils"]
    },
    "vibeflow/cockpit-who@2": {
      "requis": { "at": "string", "root": "string", "trees": "array", "fresh": "number", "fenetre": "number", "busy": "boolean", "workers": "array", "sources": "object" },
      "travailleur": {
        "requis": ["kind", "id", "tree", "source"],
        "optionnels": ["role", "task", "titre", "parent", "depth", "background", "branch", "treeBy", "cwd", "ageS", "lastAt", "stale", "orphan", "children", "dag", "etat", "dureeS", "finAt", "action", "rattachement"],
        "etats": ["actif", "en-attente", "termine"]
      },
      "rattachement": {
        "etats": ["rattache", "non-rattache"],
        "raisons": ["sans-citation", "inconnu", "ambigu"]
      },
      "interdits": ["doing", "mandat", "messages", "outils"],
      "kinds": ["session", "subagent", "lock", "registered", "dag-node"],
      "etatsSource": ["lue", "absente", "erreur", "forme-inconnue"]
    },
    "vibeflow/cockpit-project@1": {
      "requis": { "schema": "string", "meta": "object", "project": "object", "nodes": "array", "files": "array", "links": "array", "flows": "array" },
      "noeud": { "requis": ["id", "label", "kind"] },
      "element": { "requis": ["p", "n", "name"] },
      "lien": { "requis": ["a", "b", "k"] },
      "statuts": ["done", "active", "todo", "blocked"],
      "meta": { "requis": ["vfTab", "vf", "kindLabels"] }
    },
    "vibeflow/cockpit-transcript@1": {
      "requis": { "schema": "string", "id": "string" },
      "optionnels": ["mandat", "messages", "outils", "tronque", "erreur"]
    },
    "vibeflow/cockpit-equipe@1": {
      "requis": { "schema": "string", "meta": "object", "project": "object", "nodes": "array", "files": "array", "links": "array", "flows": "array" },
      "noeud": { "requis": ["id", "label", "kind"] },
      "lien": { "requis": ["a", "b", "k"] },
      "statuts": ["done", "active"],
      "interdits": ["doing", "mandat", "messages", "outils"],
      "meta": { "requis": ["vfTab", "vf", "kindLabels"] }
    },
    "vibeflow/cockpit-doing@1": {
      "requis": { "schema": "string", "id": "string", "doing": "any" }
    },
    "vibeflow/cockpit-git@1": {
      "description": "topologie Git du lab pour le tiroir (78-05, GET /api/vf/git) : requis vaut pour etat ok ; les autres etats ne portent que schema, etat, entete (sauf absent : schema, etat, entete) et commandes. auteurs : agrégés sur la fenêtre de commits lue (500 de la base et des branches non mergées), pas sur tout l'historique : l'écran ne doit pas dire « tous les auteurs ». refsIgnorees : nombre de refs sans date (tag vers un blob ou un arbre) écartées, le reste du graphe est lu",
      "requis": { "schema": "string", "etat": "string", "entete": "object", "base": "object", "worktrees": "array", "rangees": "array", "couloirsMax": "number", "replies": "number", "refsIgnorees": "number", "horsFenetre": "array", "mergees": "array", "tags": "array", "stash": "array", "auteurs": "array", "parBranche": "array", "bornes": "object", "commandes": "object" },
      "etats": ["ok", "vide", "indisponible", "absent"],
      "rangee": { "requis": ["h", "h7", "p", "at", "an", "s", "col", "entrants", "sortants", "largeur", "ouvertBas", "fusion", "racine", "teinte", "refs", "refsPlus"] },
      "interdits": ["doing", "mandat", "messages", "outils"]
    },
    "vibeflow/cockpit-git-commit@1": {
      "description": "détail d'un commit sans diff (78-08, GET /api/vf/git/commit?sha=) : requis vaut pour etat ok ; sha-invalide (400) et commit-inconnu (404) ne portent que schema et etat ; indisponible (200) aussi",
      "requis": { "schema": "string", "etat": "string", "h": "string", "h7": "string", "p": "array", "auteur": "string", "date": "string", "committer": "string", "dateCommit": "string", "message": "string", "tronque": "boolean", "fichiers": "array", "total": "number", "commandes": "object" },
      "fichier": { "requis": ["chemin", "ancien", "plus", "moins", "binaire"] },
      "etats": ["ok", "sha-invalide", "commit-inconnu", "indisponible"],
      "interdits": ["email", "diff", "patch"]
    },
    "vibeflow/cockpit-git-worktrees@1": {
      "description": "état de chaque worktree, à la demande (78-08, GET /api/vf/git/worktrees ; jamais dans le filet de 5 s) : modifies et nonSuivis bornés à 200 entrées lues (plus vrai au-delà) ; avance et retard sur la base locale, avanceOrigin et retardOrigin sur origin/<base> seulement quand elle diverge de la locale (sinon null) ; approximatif vrai (mention « approximatif : filtres du dépôt non exécutés » ; mention vaut null quand approximatif est faux) quand le dépôt déclare un filtre ; nom d'un worktree jamais une clé unique : le chemin l'est ; verifie (boolean, P78-D-38) : faux quand `<chemin>/.git` ne désigne pas `<commun>/worktrees/<id>` du dépôt lu (lien `gitdir` forgé) : le worktree est alors « non vérifié », jamais lu (status non lancé), modifies, nonSuivis, propre, avance, retard, avanceOrigin, retardOrigin et commande valent null et plus faux — la page doit afficher « non vérifié » quand verifie === false (même champ verifie sur chaque entrée worktrees de vibeflow/cockpit-git@1, dont la commande cd est alors null)",
      "requis": { "schema": "string", "etat": "string", "approximatif": "boolean", "mention": "string|null", "tronque": "boolean", "worktrees": "array" },
      "worktree": { "requis": ["chemin", "nom", "verifie", "modifies", "nonSuivis", "plus", "propre", "avance", "retard", "avanceOrigin", "retardOrigin", "commande"],
        "types": { "chemin": "string", "nom": "string", "verifie": "boolean", "modifies": "number|null", "nonSuivis": "number|null", "plus": "boolean", "propre": "boolean|null", "avance": "number|null", "retard": "number|null", "avanceOrigin": "number|null", "retardOrigin": "number|null", "commande": "string|null" } },
      "etats": ["ok", "indisponible"],
      "interdits": ["email", "diff", "patch"]
    },
    "vibeflow/cockpit-git-entete@1": {
      "requis": { "schema": "string", "etat": "string", "depot": "string" },
      "optionnels": ["branche", "worktree", "detache", "sha7"],
      "etats": ["ok", "indisponible", "absent"]
    }
  },
  "claudeCode": {
    "verifieSur": "2.1.317",
    "transcript": {
      "requis": ["cwd", "type", "message", "timestamp", "sessionId"],
      "attendus": ["gitBranch", "version"]
    },
    "metaSousAgent": {
      "requis": ["agentType", "description", "spawnDepth", "toolUseId", "requestShape"],
      "requisSiProfondeur": { "parentAgentId": 2 },
      "booleensFacultatifs": ["finished"],
      "formeArretee": { "requis": ["agentType", "stoppedByUser"], "booleens": ["stoppedByUser"] }
    },
    "transcriptSousAgent": {
      "requis": ["isSidechain", "agentId"]
    },
    "transcriptTitre": {
      "type": "custom-title",
      "champ": "customTitle",
      "typeChamp": "string",
      "refuse": ["ai-title"]
    }
  }
}
