#!/usr/bin/env bash
# post-merge — Filet de divergence : après une fusion, détecte le split-brain de workstream
# (signature S2+S4+S5, `plugin/conductor/scripts/check-divergence.sh`). Opt-in, jamais armé par
# défaut. Activation, une seule fois :
#   git config core.hooksPath scripts/hooks
#
# post-merge ne peut PAS annuler la fusion (git ignore son code de sortie pour cela, à la
# différence de `pre-push`) : son rôle est d'être BRUYANT, pas de bloquer. Le branchement
# EXPLICITE sur le code de sortie de `check-divergence.sh` est donc obligatoire — un `||` nu sur
# le code brut crierait « divergence » sur exit 3 (SILENCE, dépôt non partitionné) ou exit 2 (non
# vérifiable), c'est-à-dire sur CHAQUE fusion ordinaire de ce dépôt aujourd'hui non partitionné,
# dès l'armement du hook.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
rc=0
bash "$root/plugin/conductor/scripts/check-divergence.sh" --path "$root" || rc=$?

case "$rc" in
  1)
    echo "[post-merge] divergence de workstream détectée après fusion (voir ci-dessus)." >&2
    exit 1
    ;;
  0|3)
    exit 0
    ;;
  *)
    echo "[post-merge] check-divergence.sh non vérifiable/usage (rc=$rc) — ne bloque pas" >&2
    exit 0
    ;;
esac
